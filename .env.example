# Server-only settings. Never use a VITE_ prefix for this key.
# Add your key locally, then explicitly enable AI when you want to use quota.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_ENABLED=false

# Local PostgreSQL settings. Replace placeholders in your ignored .env.
POSTGRES_DB=your_database_name
POSTGRES_USER=your_database_user
POSTGRES_PASSWORD=replace_with_a_local_password

# API connection URL. Match the PostgreSQL values above and URL-encode credentials.
DATABASE_URL=postgresql+psycopg://your_database_user:replace_with_a_local_password@127.0.0.1:5433/your_database_name

# Tests use a separate database whose name must end in _test.
TEST_DATABASE_URL=postgresql+psycopg://your_database_user:replace_with_a_local_password@127.0.0.1:5433/your_database_name_test
